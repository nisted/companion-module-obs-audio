{
	"extends": "@companion-module/tools/tsconfig/node22/recommended-esm.json",
	"include": ["src/**/*.ts", "core/src/**/*.ts"],
	"exclude": ["node_modules/**", "test/**", "core/test/**"],
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": ".",
		"paths": {
			"*": ["./node_modules/*"]
		},
		"lib": ["ES2024"],
		"types": ["node"],
		"noUnusedLocals": false
	}
}
